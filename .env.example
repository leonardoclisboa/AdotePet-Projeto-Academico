# PROJETO ACADÊMICO: AdotePet
# Arquivo: .env.example (Modelo de Configuração Local)
# Instruções: Copie este arquivo para .env e ajuste com suas credenciais do MySQL

# Porta onde o servidor Node.js/Express vai rodar
PORT=3000

# Configurações de Conexão com o Banco de Dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql_aqui
DB_NAME=adotepet
DB_PORT=3306
